# Copy values into an ignored .env, or use scripts/cloud-env.mjs for local development.
DIDAR_ENVIRONMENT=local
DIDAR_PAYMENT_MODE=sandbox
DIDAR_SEED_DEMO=false
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/didar?sslmode=disable
REDIS_URL=redis://localhost:6379
# Generate separate values of at least 32 characters; never commit real credentials.
JWT_SECRET=
COOKIE_SECRET=
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
VENDOR_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
FILE_BACKEND_URL=http://localhost:9000/static
MERCUR_DISABLE_TELEMETRY=true
