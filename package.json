{
  "name": "marketplace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "node scripts/wait-api.mjs && bun test --env-file=packages/api/.env ./tests/pricing.test.ts ./tests/inventory.test.ts ./tests/security.test.ts ./tests/commerce.test.ts ./tests/upgraded-commerce.test.ts ./tests/phase1.test.ts ./tests/migrations.test.ts ./tests/finance.test.ts ./tests/finance-procurement.test.ts ./tests/finance-ledger.test.ts ./tests/finance-tahesab.test.ts ./tests/finance-integrated.test.ts ./tests/taxonomy-labels.test.ts ./tests/facets.test.ts ./tests/merchant-pricing.test.ts ./tests/storefront.test.ts ./tests/onboarding-media.test.ts ./tests/content.test.ts ./tests/native-panels.test.ts ./tests/native-policy.test.ts ./tests/uat-prepare.test.ts ./tests/pre-rollout-authorization.test.ts ./tests/agency-allocation.test.ts ./tests/projection-durability.test.ts ./tests/issue18-acceptance.test.ts ./tests/native-product-targets.test.ts",
    "test:e2e": "playwright test",
    "db:setup": "bun run --cwd packages/api medusa db:migrate && bun run --cwd packages/api medusa exec ./src/scripts/didar-seed.ts",
    "dev:api": "bun run --cwd packages/api dev",
    "dev:web": "bun run --cwd apps/storefront dev",
    "build:all": "bun run --cwd packages/api codegen && bun run build:panels && bun run --cwd packages/api build && bun run --cwd apps/storefront build",
    "build:panels": "node scripts/build-panels.mjs",
    "local:setup": "node scripts/local.mjs setup",
    "local:dev": "node scripts/local.mjs dev",
    "local:status": "node scripts/local.mjs status",
    "local:test": "node scripts/local.mjs test",
    "uat:prepare": "node scripts/uat-prepare.mjs",
    "tahesab:mock": "node scripts/tahesab-mock.mjs",
    "local:browser": "playwright install chromium",
    "local:stop": "node scripts/local.mjs stop"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@medusajs/icons": "2.21.2",
    "@medusajs/ui": "4.2.3",
